{
  "$schema": "https://opencode.ai/config.json",
  "username": "developer",
  "model": "openrouter/minimax/minimax-m3",
  "small_model": "openrouter/z-ai/glm-4.5-air",
  "default_agent": "sisyphus",
  "plugin": ["oh-my-openagent@latest", "opencode-codegraph"],
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": ["codegraph", "serve", "--mcp"],
      "environment": {
        "CODEGRAPH_TELEMETRY": "0"
      }
    }
  },
  "provider": {
    "openrouter": {
      "options": {
        "apiKey": "{env:OPENROUTER_API_KEY}"
      }
    }
  },
  "enabled_providers": ["openrouter"],
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "skill": "allow",
    "task": "allow",
    "todowrite": "allow",
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "external_directory": "allow",
    "bash": {
      "*": "allow",
      "git *": "allow",
      "git prune *": "ask",
      "git prune": "ask",
      "rm *": "ask",
      "rmdir *": "ask",
      "unlink *": "ask",
      "rm": "ask",
      "rmdir": "ask",
      "unlink": "ask"
    }
  },
  "logLevel": "INFO",
  "autoupdate": "notify",
  "snapshot": true,
  "tool_output": {
    "max_lines": 200,
    "max_bytes": 8192
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 1,
    "preserve_recent_tokens": 4000,
    "reserved": 2000
  }
}
