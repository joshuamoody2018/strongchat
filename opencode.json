 {
  "$schema": "https://opencode.ai/config.json",
  "username": "developer",
  "model": "opencode-go/minimax-m3",
  "small_model": "opencode-go/deepseek-v4-pro",
  "default_agent": "general",

  "plugin": ["opencode-codegraph"],

  "mcp": {
    "codegraph": {
      "type": "local",
      "command": ["codegraph", "serve", "--mcp"],
      "environment": {
        "CODEGRAPH_TELEMETRY": "0"
      }
    }
  },

  "provider": {
    "opencode-go": {
      "options": {
        "apiKey": "{env:OPENCODE_GO_API_KEY}"
      }
    },
    "opencode": {
      "options": {
        "apiKey": "{env:OPENCODE_GO_API_KEY}"
      }
    },
    "openrouter": {
      "options": {
        "apiKey": "{env:OPENROUTER_API_KEY}"
      }
    }
  },

  "enabled_providers": ["opencode-go", "opencode", "openrouter"],

  "agent": {
    "auto-router": {
      "description": "Intelligent task routing with automatic agent selection",
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4-flash",
      "fallback_models": [
        { "model": "openai/gpt-4o" },
        { "model": "anthropic/claude-3-5-sonnet-20241022" },
        { "model": "openrouter/mistralai/mistral-large" }
      ],
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "read": "allow"
      }
    },

    "architect": {
      "description": "Handles architecture, planning, and complex technical questions using MiniMax M3",
      "mode": "subagent",
      "model": "opencode-go/minimax-m3",
      "fallback_models": [
        { "model": "openai/gpt-4o" },
        { "model": "anthropic/claude-3-5-sonnet-20241022" },
        { "model": "openrouter/mistralai/mistral-large" }
      ],
      "permission": {
        "edit": "ask",
        "bash": "ask",
        "read": "allow"
      }
    },

    "developer": {
      "description": "Handles code changes, plan implementation, and straightforward development tasks using DeepSeek V4 Pro",
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4-pro",
      "fallback_models": [
        { "model": "openai/gpt-4o" },
        { "model": "anthropic/claude-3-5-sonnet-20241022" },
        { "model": "openrouter/mistralai/mistral-large" }
      ],
      "permission": {
        "edit": "allow",
        "bash": "ask",
        "read": "allow"
      }
    },

    "visual-engineering": {
      "model": "opencode-go/kimi-k2.7-code",
      "fallback_models": [
        { "model": "openai/gpt-4o" },
        { "model": "anthropic/claude-3-5-sonnet-20241022" },
        { "model": "openrouter/mistralai/mistral-large" }
      ]
    },

    "ultrabrain": {
      "model": "opencode-go/minimax-m3",
      "fallback_models": [
        { "model": "openai/gpt-4o" },
        { "model": "anthropic/claude-3-5-sonnet-20241022" },
        { "model": "openrouter/mistralai/mistral-large" }
      ]
    },

    "deep": {
      "model": "opencode-go/minimax-m3",
      "fallback_models": [
        { "model": "openai/gpt-4o" },
        { "model": "anthropic/claude-3-5-sonnet-20241022" },
        { "model": "openrouter/mistralai/mistral-large" }
      ]
    },

    "artistry": {
      "model": "opencode-go/minimax-m3",
      "fallback_models": [
        { "model": "openai/gpt-4o" },
        { "model": "anthropic/claude-3-5-sonnet-20241022" },
        { "model": "openrouter/mistralai/mistral-large" }
      ]
    },

    "quick": {
      "model": "opencode-go/minimax-m3.7",
      "fallback_models": [
        { "model": "openai/gpt-4o" },
        { "model": "anthropic/claude-3-5-sonnet-20241022" },
        { "model": "openrouter/mistralai/mistral-large" }
      ]
    },

    "unspecified-low": {
      "model": "opencode-go/qwen3.5-plus",
      "fallback_models": [
        { "model": "openai/gpt-4o" },
        { "model": "anthropic/claude-3-5-sonnet-20241022" },
        { "model": "openrouter/mistralai/mistral-large" }
      ]
    },

    "unspecified-high": {
      "model": "opencode-go/minimax-m3",
      "fallback_models": [
        { "model": "openai/gpt-4o" },
        { "model": "anthropic/claude-3-5-sonnet-20241022" },
        { "model": "openrouter/mistralai/mistral-large" }
      ]
    },

    "writing": {
      "model": "opencode-go/qwen3.5-plus",
      "fallback_models": [
        { "model": "openai/gpt-4o" },
        { "model": "anthropic/claude-3-5-sonnet-20241022" },
        { "model": "openrouter/mistralai/mistral-large" }
      ]
    }
  },

  "experimental": {
    "primary_tools": ["edit", "read"]
  },

  "instructions": [
    "AGENTS.md",
    "LLM_FRAMEWORK.md",
    "architecture/",
    ".codegraph/AGENTS.md",
    ".codegraph/SCENARIO_PLAYBOOK.md"
  ],

  "references": {
    "docs": {
      "path": "architecture",
      "description": "System design and architecture documentation"
    },
    "code": {
      "path": "src",
      "description": "Source code and implementation details"
    }
  },

  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "skill": "allow",
    "task": "allow",
    "todowrite": "allow",
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "external_directory": "allow",
    "bash": {
      "*": "allow",
      "git *": "allow",
      "git prune *": "ask",
      "git prune": "ask",
      "rm *": "ask",
      "rmdir *": "ask",
      "unlink *": "ask",
      "rm": "ask",
      "rmdir": "ask",
      "unlink": "ask"
    }
  },

  "logLevel": "INFO",
  "autoupdate": "notify",
  "snapshot": true,

  "tool_output": {
    "max_lines": 200,
    "max_bytes": 8192
  },

  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 1,
    "preserve_recent_tokens": 4000,
    "reserved": 2000
  }
}
