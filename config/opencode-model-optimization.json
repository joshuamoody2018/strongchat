{
  "$schema": "https://opencode.ai/config.json",
  "username": "developer",
  "model": "opencode-go/glm-4.5-air",
  "small_model": "opencode-go/deepseek-v4-pro",
  "default_agent": "general",

  "plugin": ["opencode-codegraph"],

  "mcp": {
    "codegraph": {
      "type": "local",
      "command": ["codegraph", "serve", "--mcp"],
      "environment": {
        "CODEGRAPH_TELEMETRY": "0"
      }
    }
  },

  "provider": {
    "opencode-go": {
      "options": {
        "apiKey": "{env:OPENCODE_GO_API_KEY}"
      }
    },
    "opencode": {
      "options": {
        "apiKey": "{env:OPENCODE_GO_API_KEY}"
      }
    },
    "openrouter": {
      "options": {
        "apiKey": "{env:OPENROUTER_API_KEY}"
      }
    }
  },

  "enabled_providers": ["opencode-go", "opencode", "openrouter"],

  "agent": {
    "auto-router": {
      "description": "Intelligent task routing with automatic agent selection",
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4-flash",
      "fallback_models": [
        { "model": "openai/gpt-4o" },
        { "model": "anthropic/claude-3-5-sonnet-20241022" },
        { "model": "openrouter/mistralai/mistral-large" }
      ],
      "permission": {
        "read": ["**/*"],
        "write": ["**/*"],
        "execute": ["**/*.py", "**/*.sh", "**/*.md"]
      }
    },
    "architect": {
      "description": "Handles architecture, planning, and complex technical questions using MiniMax M3",
      "mode": "subagent",
      "model": "opencode-go/minimax-m3",
      "fallback_models": [
        { "model": "openai/gpt-4o" },
        { "model": "anthropic/claude-3-5-sonnet-20241022" },
        { "model": "openrouter/mistralai/mistral-large" }
      ],
      "permission": {
        "read": ["**/*"],
        "write": ["**/*"],
        "execute": ["**/*.py", "**/*.sh", "**/*.md"]
      }
    },
    "developer": {
      "description": "Handles code changes, plan implementation, and straightforward development tasks using DeepSeek V4 Pro",
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4-pro",
      "fallback_models": [
        { "model": "openai/gpt-4o" },
        { "model": "anthropic/claude-3-5-sonnet-20241022" },
        { "model": "openrouter/mistralai/mistral-large" }
      ],
      "permission": {
        "read": ["**/*"],
        "write": ["**/*"],
        "execute": ["**/*.py", "**/*.sh", "**/*.md"]
      }
    },
    "explore": {
      "description": "Contextual grep for codebases",
      "mode": "subagent",
      "model": "opencode-go/glm-4.5-air",
      "fallback_models": [
        { "model": "openai/gpt-4o" },
        { "model": "anthropic/claude-3-5-sonnet-20241022" },
        { "model": "openrouter/mistralai/mistral-large" }
      ],
      "permission": {
        "read": ["**/*"],
        "write": [],
        "execute": []
      }
    },
    "librarian": {
      "description": "Specialized codebase understanding agent for multi-repository analysis",
      "mode": "subagent",
      "model": "opencode-go/glm-4.5-air",
      "fallback_models": [
        { "model": "openai/gpt-4o" },
        { "model": "anthropic/claude-3-5-sonnet-20241022" },
        { "model": "openrouter/mistralai/mistral-large" }
      ],
      "permission": {
        "read": ["**/*"],
        "write": [],
        "execute": []
      }
    }
  },

  "category": {
    "visual-engineering": {
      "model": "opencode-go/kimi-k2.7-code",
      "variant": "high",
      "fallback_models": [
        { "model": "openai/gpt-4o" },
        { "model": "anthropic/claude-3-5-sonnet-20241022" },
        { "model": "openrouter/mistralai/mistral-large" }
      ]
    },
    "ultrabrain": {
      "model": "opencode-go/kimi-k2.7-code",
      "variant": "max",
      "fallback_models": [
        { "model": "openai/gpt-4o" },
        { "model": "anthropic/claude-3-5-sonnet-20241022" },
        { "model": "openrouter/mistralai/mistral-large" }
      ]
    },
    "deep": {
      "model": "opencode-go/kimi-k2.7-code",
      "variant": "max",
      "fallback_models": [
        { "model": "openai/gpt-4o" },
        { "model": "anthropic/claude-3-5-sonnet-20241022" },
        { "model": "openrouter/mistralai/mistral-large" }
      ]
    },
    "artistry": {
      "model": "opencode-go/kimi-k2.7-code",
      "variant": "high",
      "fallback_models": [
        { "model": "openai/gpt-4o" },
        { "model": "anthropic/claude-3-5-sonnet-20241022" },
        { "model": "openrouter/mistralai/mistral-large" }
      ]
    },
    "quick": {
      "model": "opencode-go/glm-4.5-air",
      "fallback_models": [
        { "model": "openai/gpt-4o" },
        { "model": "anthropic/claude-3-5-sonnet-20241022" },
        { "model": "openrouter/mistralai/mistral-large" }
      ]
    },
    "unspecified-low": {
      "model": "opencode-go/glm-4.5-air",
      "fallback_models": [
        { "model": "openai/gpt-4o" },
        { "model": "anthropic/claude-3-5-sonnet-20241022" },
        { "model": "openrouter/mistralai/mistral-large" }
      ]
    },
    "unspecified-high": {
      "model": "opencode-go/glm-4.5-air",
      "fallback_models": [
        { "model": "openai/gpt-4o" },
        { "model": "anthropic/claude-3-5-sonnet-20241022" },
        { "model": "openrouter/mistralai/mistral-large" }
      ]
    },
    "writing": {
      "model": "opencode-go/glm-4.5-air",
      "fallback_models": [
        { "model": "openai/gpt-4o" },
        { "model": "anthropic/claude-3-5-sonnet-20241022" },
        { "model": "openrouter/mistralai/mistral-large" }
      ]
    }
  }
}